# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# `.env.local` giữ EDGE_VLA_TOKEN — đã nằm trong `.env*` ở trên, ghi lại một lần
# nữa cho rõ ràng vì đây là dòng không được phép mất.
.env.local
# Ngược lại, `.env.example` PHẢI được commit: nó là bản mẫu, không chứa bí mật.
# Dòng phủ định này bắt buộc đứng SAU `.env*`, nếu không nó bị nuốt.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
