# Cloud Agent LLM (đọc bởi server/main.py qua python-dotenv, không hardcode)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Edge MCP server (mặc định khớp edge_vla/config.py:MCP_PORT + FastMCP streamable_http_path=/mcp)
EDGE_MCP_URL=http://localhost:8931/mcp

# Ports
VLA_MCP_PORT=8931
VLA_SERVER_PORT=8000

# n_action_steps replay (xem edge_vla/config.py) — mặc định 10 theo Task 0 spike
VLA_N_ACTION_STEPS=10
